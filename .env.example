# Findernate backend — environment template.
#
# Copy to .env and fill in. Values here are placeholders, never real secrets.
#
# The variables marked ⚠ have SILENT failure modes: the app boots fine without
# them and something important stops working with no error in the logs. They
# are listed first for that reason.

# ─────────────────────────────────────────────────────────────────────────────
# ⚠ SILENT-FAILURE VARIABLES — check these first when something "just stopped"
# ─────────────────────────────────────────────────────────────────────────────

# ⚠ Cashfree webhook signature verification FAILS CLOSED without this.
# Missing => every webhook delivery is rejected 401 and NO order is ever
# marked paid by the webhook path. Payments still succeed at Cashfree, so the
# money is taken while orders sit at 'pending' forever. This is the single
# most damaging variable to omit, and nothing in the logs says "misconfigured".
# It is the CLIENT SECRET from the Cashfree dashboard, not the app id.
CASHFREE_SECRET_KEY=
CASHFREE_APP_ID=
CASHFREE_ENV=sandbox              # 'production' for live payments

# ⚠ Where the "a guest order could not be auto-refunded" alert goes.
# Missing => that failure is a console.error and a database marker only, and
# nobody is told. Real money stays stuck with no human in the loop.
# SUPPORT_EMAIL is the fallback if ADMIN_ALERT_EMAIL is unset.
ADMIN_ALERT_EMAIL=
SUPPORT_EMAIL=

# ⚠ Must be on findernate.com, or transactional mail lands in spam.
# SPF/DKIM align to the sending domain, so mail sent as another company's
# domain while branded "FinderNate" is scored as spoofing. That silently
# breaks the guest-checkout "set your password" link — the ONLY route a guest
# has into the account created for them.
# EMAIL_USER is the SMTP login. EMAIL_FROM is optional and only needed when
# sending AS a different (verified alias) address than the one you log in with.
EMAIL_HOST=smtp.zoho.com          # must be a hostname; a display name here is ignored
EMAIL_PORT=465                    # 465 = implicit TLS, 587 = STARTTLS
EMAIL_USER=no-reply@findernate.com
EMAIL_PASS=
EMAIL_FROM=                       # optional, defaults to EMAIL_USER
EMAIL_FROM_NAME=FinderNate

# ⚠ Leave UNSET in any deployment behind a proxy (nginx, Coolify, a load
# balancer) — it defaults to trusting one hop, which is what makes req.ip the
# real client. Set to 'false' ONLY when running with no proxy in front.
# Get this wrong and every rate limiter keys on the proxy's address, so the
# whole platform shares one bucket and the limiters lock everybody out at once.
# TRUST_PROXY=false

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://findernate.com
BACKEND_URL=https://apis.findernate.com

MONGODB_URI=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────────────────────────
# Auth
#
# NOTE: ACCESS_TOKEN_EXPIRY is currently shared by BOTH user and admin tokens
# (user.models.js and admin.models.js read the same variable). A long value is
# reasonable for users — there is no refresh endpoint, so a short one means
# frequent forced re-logins — but the same token on an admin can read every
# seller's bank details. Splitting admins onto their own shorter expiry is a
# pending decision; if you add ADMIN_ACCESS_TOKEN_EXPIRY, wire it in
# admin.models.js and fall back to this value when it is unset.
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=365d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=365d

# ─────────────────────────────────────────────────────────────────────────────
# Media (Bunny)
# ─────────────────────────────────────────────────────────────────────────────
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_API_URL=
BUNNY_CDN_URL=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Realtime / push / calls
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

STREAM_API_KEY=
STREAM_API_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=no-reply@findernate.com

# ─────────────────────────────────────────────────────────────────────────────
# Search (optional)
#
# Unset => Typesense is disabled and search falls back to the MongoDB path.
# That fallback works, but it is NOT the code that runs in production, so a
# search change verified only with these unset has not really been verified.
# ─────────────────────────────────────────────────────────────────────────────
TYPESENSE_HOST=
TYPESENSE_PORT=
TYPESENSE_PROTOCOL=
TYPESENSE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# First admin (scripts/createAdmin.js)
#
# The script refuses to run without these — it used to hardcode a published
# email and password, and the account it created was a super admin that no API
# route can revoke.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Google Play Billing (Android subscriptions)
#
# Play requires its own billing system for anything unlocking in-app
# functionality, so the app's subscriptions go through Play rather than
# Cashfree. Cashfree still handles the website and the physical-goods store.
#
# Full console setup — service account, API access linkage, RTDN topic — is in
# GOOGLE_PLAY_BILLING_SETUP.md. Unset => the verify endpoint returns 503 and
# the nightly expiry job leaves Play subscriptions alone rather than guessing.
# ─────────────────────────────────────────────────────────────────────────────

# Service-account JSON from Google Cloud, granted access in Play Console under
# Setup > API access. Either the raw JSON or base64 of it — prefer base64, as
# .env files mangle the newlines inside private_key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Alternative to the above: a path to the JSON on disk. Set one or the other.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# Defaults to com.findernate.app when unset.
GOOGLE_PLAY_PACKAGE_NAME=

# Shared secret for the Pub/Sub push URL carrying Real-time Developer
# Notifications (?token=...). It is the ONLY authentication on that route, which
# is public because Pub/Sub has no user session. Long and random, please.
GOOGLE_PLAY_RTDN_SECRET=

# ── Plans and limits (all optional; defaults are in src/utils/planLimits.js) ──
# Free monthly post allowance for business accounts (default 10).
# FREE_MONTHLY_POST_LIMIT=10
# enforce (default) | warn (log only, nobody is blocked) | off
# POST_QUOTA_MODE=enforce
# Before this ISO date 'enforce' behaves like 'warn', e.g. 2026-11-01T00:00:00+05:30
# POST_QUOTA_ENFORCE_FROM=
# Comma separated plan ids to hold back without an app release, e.g. corporate.
# Clients show "Coming soon" and create-order refuses the plan.
# PLANS_COMING_SOON=
# Support reply targets in hours (business hours are applied on top).
# SUPPORT_SLA_HOURS_STANDARD=72
# SUPPORT_SLA_HOURS_PRIORITY=24
# SUPPORT_SLA_HOURS_DEDICATED=8
